{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vue Block Editor",
  "version": "0.1.0",
  "identifier": "com.my-notebook.vue-block-editor",
  "build": {
    "beforeBuildCommand": "pnpm docs:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../docs-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vue Block Editor",
        "url": "demo.html?type=editor",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
